# One public URL; UI/API/WebSockets automatically use the browser's origin.
# Set HTTPS here when a TLS reverse proxy forwards this domain to the single HTTP port.
# PUBLIC_URL=https://skyvern.example.com
SKYVERN_PORT=8081
# Use 127.0.0.1 when your HTTPS reverse proxy runs on this same host.
SKYVERN_BIND_ADDRESS=0.0.0.0

# Leave these empty to generate a private initial admin login in /data/state/admin-login.txt.
SKYVERN_ADMIN_EMAIL=
SKYVERN_ADMIN_PASSWORD_HASH=

# LLM configuration: choose your provider and supply its secret.
ENABLE_OPENAI=true
LLM_KEY=OPENAI_GPT5_5
OPENAI_API_KEY=

# Optional existing database. Leave unset for PostgreSQL inside this image.
# DATABASE_STRING=postgresql+psycopg://user:password@database.example.com:5432/skyvern

# Signing/encryption secrets are generated once in the persistent volume by default.
# Keep the same volume or explicitly supply stable secrets when restoring an existing database.
# SECRET_KEY=
# ENCRYPTOR_AES_SECRET_KEY=

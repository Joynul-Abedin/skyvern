# Browser streaming mode:
# - cdp: use local browser streaming through the backend
# - vnc: use VNC streaming
# Quickstart writes cdp for new local installs; app code falls back to vnc if unset.
VITE_BROWSER_STREAMING_MODE=cdp

# Optional single-admin login. These values are read only by the UI server.
# Generate credentials and a password hash with: npm run configure-admin -- admin@example.com
# Never prefix these variables with VITE_ or store a plaintext password here.
SKYVERN_ADMIN_EMAIL=
SKYVERN_ADMIN_PASSWORD_HASH=
# Sessions persist until explicit logout. Optional override for the private session file.
# SKYVERN_ADMIN_SESSIONS_FILE=/absolute/path/to/admin-sessions.json
# Enable only when serving the UI over HTTPS.
SKYVERN_ADMIN_COOKIE_SECURE=false

VITE_API_BASE_URL=http://localhost:7878/api/v1

# server to load artifacts from file URIs
VITE_ARTIFACT_API_BASE_URL=http://localhost:8787

# websocket
# VITE_WSS_BASE_URL=wss://api-staging.skyvern.com/api/v1
VITE_WSS_BASE_URL=ws://localhost:7878/api/v1

# your api key - for x-api-key header
VITE_SKYVERN_API_KEY=YOUR_API_KEY

# Enable recording skyvern logs as artifacts
VITE_ENABLE_LOG_ARTIFACTS=false

# Enable code block node
VITE_ENABLE_CODE_BLOCK=true

# Enable 2FA verification code notifications (toasts, sounds, OS notifications, WebSocket streaming)
# Set to "false" to disable for orgs with high task/workflow volume
VITE_ENABLE_2FA_NOTIFICATIONS=true
